# internly Configuration
# Copy this to .env and fill in your values

# ─── Required: API Keys ──────────────────────────────────────────────────────

# OpenCode Zen API key (for generating observations from homepages)
# Get yours at: https://opencode.ai/auth
ZEN_API_KEY=

# Gmail OAuth (for sending emails)
# See GOOGLE_CLOUD_SETUP.md for step-by-step setup
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Required: Your Info ─────────────────────────────────────────────────────

# Your name (appears in emails)
YOUR_NAME=

# Your main project URL (proof you build things)
YOUR_LINK=

# Your GitHub profile
YOUR_GITHUB=

# Your portfolio or website (optional)
YOUR_PORTFOLIO=

# Your elevator pitch (1-2 sentences about what you build)
# Example: "My latest project is LinkUp, a shared space for friend groups to plan events and split expenses."
YOUR_PITCH=

# ─── Optional: Sending Config ────────────────────────────────────────────────

# Max emails per day (default: 25)
DAILY_LIMIT=25

# Seconds between sends (default: 2.0)
SEND_DELAY=2.0

# YC batches to target (comma-separated)
YC_BATCHES=Summer 2024,Winter 2025,Summer 2025,Winter 2026

# YC stages to target (comma-separated)
YC_STAGES=Early,Growth
